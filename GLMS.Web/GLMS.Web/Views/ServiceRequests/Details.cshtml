@model GLMS.Web.Models.ServiceRequest
@using GLMS.Web.Models
@{
    ViewData["Title"] = "Service Request Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🔧 Service Request Details</h2>
    <a asp-action="Index" class="btn btn-secondary">← Back</a>
</div>

<div class="row g-4">

    @* Request information card *@
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                Request Information
            </div>
            <div class="card-body">
                <p><strong>Contract:</strong> @Model.Contract?.Title</p>
                <p><strong>Client:</strong> @Model.Contract?.Client?.Name</p>
                <p><strong>Description:</strong> @Model.Description</p>
                <p>
                    <strong>Cost (USD):</strong>
                    $@(Model.CostUsd.ToString("N2"))
                </p>
                <p>
                    <strong>Cost (ZAR):</strong>
                    R@(Model.CostZar.ToString("N2"))
                </p>
                <p>
                    <strong>Exchange Rate Used:</strong>
                    @(Model.ExchangeRateUsed.ToString("F4"))
                </p>
                <p>
                    <strong>Created On:</strong>
                    @(Model.CreatedOn.ToString("dd MMM yyyy HH:mm"))
                </p>
                <p>
                    <strong>Status:</strong>
                    <span class="badge @(Model.Status == ServiceRequestStatus.Completed ? "bg-success" :
                                                                                           Model.Status == ServiceRequestStatus.Cancelled ? "bg-danger" :
                                                                                           Model.Status == ServiceRequestStatus.InProgress ? "bg-primary" :
                                                                                           "bg-warning text-dark")">
                        @Model.Status
                    </span>
                </p>
            </div>
        </div>
    </div>

    @* Status update card — Admin only *@
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    Update Status
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Change the current status of this service request.
                        <br />
                        Pending → InProgress → Completed or Cancelled
                    </p>
                    <form asp-action="UpdateStatusConfirmed" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-bold">New Status</label>
                            <select name="newStatus" class="form-select"
                                    asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()">
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            ✅ Update Status
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Non-admin users see a message instead of the update form *@
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    Status
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-0">
                        <small>
                            🔒 Only Admins can update the status
                            of a service request.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>