@model IEnumerable<GLMS.Web.Models.ServiceRequest>
@using GLMS.Web.Models
@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🔧 Service Requests</h2>
    @* Only Admin and Manager can create service requests *@
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-warning">+ New Request</a>
    }
</div>

@* Show a read only notice to Viewers *@
@if (User.IsInRole("Viewer"))
{
    <div class="alert alert-info">
        <small>
            🔒 You have read-only access.
            Contact a Manager or Admin to raise service requests.
        </small>
    </div>
}

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Contract</th>
            <th>Client</th>
            <th>Description</th>
            <th>Cost (USD)</th>
            <th>Cost (ZAR)</th>
            <th>Rate Used</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sr in Model)
        {
            <tr>
                <td>@sr.Contract?.Title</td>
                <td>@sr.Contract?.Client?.Name</td>
                <td>@sr.Description</td>
                <td>$@(sr.CostUsd.ToString("N2"))</td>
                <td>R@(sr.CostZar.ToString("N2"))</td>
                <td>@(sr.ExchangeRateUsed.ToString("F4"))</td>
                <td>
                    @* Colour coded status badge *@
                    <span class="badge @(sr.Status == ServiceRequestStatus.Completed ? "bg-success" :
                                                                                           sr.Status == ServiceRequestStatus.Cancelled ? "bg-danger" :
                                                                                           sr.Status == ServiceRequestStatus.InProgress ? "bg-primary" :
                                                                                           "bg-warning text-dark")">
                        @sr.Status
                    </span>
                </td>
                <td>@(sr.CreatedOn.ToString("dd MMM yyyy"))</td>
                <td>
                    @* All roles can view details *@
                    <a asp-action="Details" asp-route-id="@sr.Id"
                       class="btn btn-sm btn-outline-primary">Details</a>

                    @* Only Admin can update the status *@
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="UpdateStatus" asp-route-id="@sr.Id"
                               class="btn btn-sm btn-outline-secondary ms-1">
                            Update Status
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>