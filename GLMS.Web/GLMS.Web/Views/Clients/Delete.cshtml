@model GLMS.Web.Models.Client
@{
    ViewData["Title"] = "Delete Client";
}

@if (!User.IsInRole("Admin"))
{
    <div class="alert alert-danger">
        You do not have permission to delete clients.
    </div>
}
else
{
    <h2>🗑️ Delete Client</h2>
    <hr />

    @if (Model.Contracts.Any())
    {
        <!-- Client has contracts — show warning and list them -->
        <div class="alert alert-danger">
            <strong>⚠️ You cannot delete this client yet.</strong>
            <br />
            This client has <strong>@Model.Contracts.Count()</strong> contract(s) linked to them.
            You must delete all their contracts first before deleting the client.
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                Contracts That Must Be Deleted First
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model.Contracts)
                        {
                            <tr>
                                <td>@contract.Title</td>
                                <td>@contract.Status</td>
                                <td>@contract.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@contract.EndDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <!-- Delete button for each contract -->
                                    <a asp-controller="Contracts"
                                           asp-action="Delete"
                                           asp-route-id="@contract.Id"
                                           class="btn btn-sm btn-danger">
                                        Delete Contract
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-secondary">← Back to Clients</a>
    }
    else
    {
        <!-- Client has no contracts — safe to delete -->
        <div class="alert alert-warning">
            <strong>Are you sure you want to delete this client?</strong>
            <br />
            <small>This action cannot be undone.</small>
        </div>

        <div class="card shadow-sm col-md-5">
            <div class="card-body">
                <p><strong>Name:</strong> @Model.Name</p>
                <p><strong>Email:</strong> @Model.ContactEmail</p>
                <p><strong>Phone:</strong> @Model.ContactPhone</p>
                <p><strong>Region:</strong> @Model.Region</p>
            </div>
        </div>

        <div class="mt-4">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Yes, Delete Client</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    }
}